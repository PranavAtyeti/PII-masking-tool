# Groq free-tier cloud API (get a free key at https://console.groq.com/keys --
# no credit card required). You can also paste/change the key live in the
# app's sidebar without editing this file or restarting the app.
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.1-8b-instant

# --- Answer-quality tuning (optional -- sane defaults are used if omitted) ---
# Lower = more deterministic/factual answers, higher = more varied wording.
# 0.1 is recommended for data Q&A; raise it only if answers feel too terse/robotic.
MODEL_TEMPERATURE=0.1
