# ------------------------------------------------------------
# Privy encrypted cloud storage (Step 1)
# ------------------------------------------------------------
# Google Cloud project containing the GCS bucket.
GCS_PROJECT_ID=your-gcp-project-id

# Existing GCS bucket name. Recommended for dev: a single-region
# Standard Storage bucket in us-central1/us-east1/us-west1.
GCS_BUCKET_NAME=privy-files-dev

# 256-bit application encryption key, URL-safe base64 encoded.
# Generate one with:
# python -c "from app.encryption import generate_master_key; print(generate_master_key())"
# Do NOT commit the real value.
PRIVY_ENCRYPTION_KEY= ozma1KbJ-5SB2e27vjhm2wJ9AwUsdtyU8XXgr5ObE8Y=
