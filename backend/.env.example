# PostgreSQL database
DATABASE_URL=postgresql+psycopg://privy:privy@localhost:5432/privy

# Auth0 API validation
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://privy-api

# CORS: comma-separated frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# Default model provider. Configure at least one provider API key.
LLM_PROVIDER=groq
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# GEMINI_API_KEY=replace_with_your_gemini_api_key
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

MODEL_TEMPERATURE=0.1

# Guest upload limits
PRIVY_GUEST_MAX_FILES=3
PRIVY_GUEST_MAX_FILE_SIZE_MB=10

# Authoritative upload limits
PRIVY_MAX_REQUEST_BYTES=52428800
PRIVY_MAX_FILE_SIZE_BYTES=10485760
PRIVY_MAX_FILES_PER_CHAT=10
PRIVY_MAX_ROWS_PER_FILE=100000
PRIVY_MAX_CELLS_PER_FILE=2000000
PRIVY_MAX_XLSX_ZIP_ENTRIES=10000
PRIVY_MAX_XLSX_UNCOMPRESSED_BYTES=104857600
PRIVY_MAX_XLSX_ENTRY_BYTES=52428800
PRIVY_MAX_XLSX_COMPRESSION_RATIO=200

# Encryption and lifecycle
PRIVY_ENVIRONMENT=development
PRIVY_ENCRYPTION_KEY=
# Production only:
# PRIVY_KMS_KEY_NAME=projects/PROJECT_ID/locations/LOCATION/keyRings/RING/cryptoKeys/KEY
# Stable 32-byte key used only for encrypted mapping blind indexes.
PRIVY_BLIND_INDEX_KEY=
PRIVY_TEMP_FILE_RETENTION_SECONDS=86400
PRIVY_ABANDONED_UPLOAD_RETENTION_SECONDS=86400
PRIVY_PROVIDER_RESOURCE_RETENTION_SECONDS=172800

# Conversation and file-context limits. Increase only when supported by the
# selected model provider and available server memory.
PRIVY_MAX_CONTEXT_TOKENS_PER_FILE=90000
PRIVY_MAX_TOTAL_FILE_CONTEXT_TOKENS=110000
PRIVY_MAX_HISTORY_MESSAGES=32
PRIVY_CONCISE_MAX_OUTPUT_TOKENS=2048
PRIVY_DETAILED_MAX_OUTPUT_TOKENS=16384
