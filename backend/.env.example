# PostgreSQL database
DATABASE_URL=postgresql+psycopg://privy:privy@localhost:5432/privy

# Auth0 API validation
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://privy-api

# CORS: comma-separated frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# Default model provider. Configure at least one provider API key.
LLM_PROVIDER=groq
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# GEMINI_API_KEY=replace_with_your_gemini_api_key
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

MODEL_TEMPERATURE=0.1

# Guest upload limits
PRIVY_GUEST_MAX_FILES=3
PRIVY_GUEST_MAX_FILE_SIZE_MB=10

# Conversation and file-context limits. Increase only when supported by the
# selected model provider and available server memory.
PRIVY_MAX_CONTEXT_TOKENS_PER_FILE=40000
PRIVY_MAX_TOTAL_FILE_CONTEXT_TOKENS=100000
PRIVY_MAX_HISTORY_MESSAGES=32
PRIVY_CONCISE_MAX_OUTPUT_TOKENS=600
PRIVY_DETAILED_MAX_OUTPUT_TOKENS=4000
